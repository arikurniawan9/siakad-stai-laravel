[Unit]
Description=SIAKAD Laravel queue worker
After=network.target mysql.service redis-server.service

[Service]
Type=simple
User=siakad-staialittihad
Group=siakad-staialittihad
WorkingDirectory=/home/siakad-staialittihad/htdocs/siakad-staialittihad.tech
ExecStart=/usr/bin/php artisan queue:work redis --sleep=3 --tries=5 --timeout=120 --max-time=3600
Restart=always
RestartSec=5
TimeoutStopSec=130
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
