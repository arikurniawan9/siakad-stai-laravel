APP_NAME="SIAKAD OS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://siakad-staialittihad.tech
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siakad
DB_USERNAME=siakad
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.ac.id
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=noreply@example.ac.id
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
SIAKAD_TIMEZONE=Asia/Jakarta
SIAKAD_INSTITUTION="STAI Al-Ittihad"
SIAKAD_ADMIN_USERNAME=admin
SIAKAD_ADMIN_EMAIL=admin@example.ac.id
SIAKAD_ADMIN_PASSWORD=

FINANCE_NOTIFICATION_EMAIL_ENABLED=true
FINANCE_NOTIFICATION_WHATSAPP_ENABLED=false
WHATSAPP_DRIVER=log

BSI_ENABLED=false
BSI_VA_DRIVER=fake
BSI_ENVIRONMENT=sandbox
BSI_BASE_URL=
BSI_CALLBACK_SECRET=

SUPERADMIN_MYSQL_BIN_PATH=
